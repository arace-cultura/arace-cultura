<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.HomePage">

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/background"
        android:layout_marginTop="50dp">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_search_bar"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:hint="Pesquisar"
            android:paddingStart="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Categorias"
            android:textSize="24sp"
            android:fontFamily="serif"
            android:textColor="@color/texto" />

        <GridLayout

            android:id="@+id/grid"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:columnCount="4"

            android:layout_marginTop="20dp"

            android:alignmentMode="alignMargins">



            <LinearLayout

                android:layout_width="0dp"

                android:layout_height="wrap_content"

                android:layout_columnWeight="1"

                android:gravity="center"

                android:orientation="vertical">



                <androidx.cardview.widget.CardView

                    android:layout_width="50dp"

                    android:layout_height="50dp"

                    app:cardBackgroundColor="@color/verde"

                    app:cardElevation="2dp">



                    <ImageView

                        android:layout_width="match_parent"

                        android:layout_height="match_parent"

                        android:padding="12dp"

                        android:src="@drawable/ic_pallete" />

                </androidx.cardview.widget.CardView>



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Pinturas"

                    android:textColor="@color/texto"

                    android:textSize="11sp" />

            </LinearLayout>



            <LinearLayout

                android:layout_width="0dp"

                android:layout_height="wrap_content"

                android:layout_columnWeight="1"

                android:gravity="center"

                android:orientation="vertical">



                <androidx.cardview.widget.CardView

                    android:layout_width="50dp"

                    android:layout_height="50dp"

                    app:cardBackgroundColor="@color/verde"



                    app:cardElevation="2dp">



                    <ImageView

                        android:layout_width="match_parent"

                        android:layout_height="match_parent"

                        android:padding="12dp"

                        android:src="@drawable/ic_home" />

                </androidx.cardview.widget.CardView>



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Casa &amp; Vida"

                    android:textColor="@color/texto"

                    android:textSize="11sp" />

            </LinearLayout>



            <LinearLayout

                android:layout_width="0dp"

                android:layout_height="wrap_content"

                android:layout_columnWeight="1"

                android:gravity="center"

                android:orientation="vertical">



                <androidx.cardview.widget.CardView

                    android:layout_width="50dp"

                    android:layout_height="50dp"

                    app:cardBackgroundColor="@color/verde"

                    app:cardCornerRadius="4dp"

                    app:cardElevation="2dp">



                    <ImageView

                        android:layout_width="match_parent"

                        android:layout_height="match_parent"

                        android:padding="12dp"

                        android:src="@drawable/ic_retro" />

                </androidx.cardview.widget.CardView>



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Retrô"

                    android:textColor="@color/texto"

                    android:textSize="11sp" />

            </LinearLayout>



            <LinearLayout

                android:layout_width="0dp"

                android:layout_height="wrap_content"

                android:layout_columnWeight="1"

                android:gravity="center"

                android:orientation="vertical">



                <androidx.cardview.widget.CardView

                    android:layout_width="50dp"

                    android:layout_height="50dp"

                    app:cardBackgroundColor="@color/verde"

                    app:cardCornerRadius="4dp"

                    app:cardElevation="2dp">



                    <ImageView

                        android:layout_width="match_parent"

                        android:layout_height="match_parent"

                        android:padding="12dp"

                        android:src="@drawable/ic_eco" />

                </androidx.cardview.widget.CardView>



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Ecodesign"

                    android:textColor="@color/texto"

                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout

                android:layout_width="0dp"

                android:layout_height="wrap_content"

                android:layout_columnWeight="1"

                android:gravity="center"

                android:orientation="vertical"

                android:layout_marginBottom="16dp">



                <androidx.cardview.widget.CardView

                    android:layout_width="50dp"

                    android:layout_height="50dp"

                    app:cardBackgroundColor="@color/laranja"

                    app:cardCornerRadius="4dp"

                    app:cardElevation="2dp">



                    <ImageView

                        android:layout_width="match_parent"

                        android:layout_height="match_parent"

                        android:padding="12dp"

                        android:src="@drawable/ic_shirt" />

                </androidx.cardview.widget.CardView>



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Roupas"

                    android:textColor="@color/texto"

                    android:textSize="11sp" />

            </LinearLayout>



            <LinearLayout

                android:layout_width="0dp"

                android:layout_height="wrap_content"

                android:layout_columnWeight="1"

                android:gravity="center"

                android:orientation="vertical">



                <androidx.cardview.widget.CardView

                    android:layout_width="50dp"

                    android:layout_height="50dp"

                    app:cardBackgroundColor="@color/laranja"

                    app:cardCornerRadius="4dp"

                    app:cardElevation="2dp">



                    <ImageView

                        android:layout_width="match_parent"

                        android:layout_height="match_parent"

                        android:padding="12dp"

                        android:src="@drawable/ic_necklace" />

                </androidx.cardview.widget.CardView>



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Acessórios"

                    android:textColor="@color/texto"

                    android:textSize="11sp" />

            </LinearLayout>



            <LinearLayout

                android:layout_width="0dp"

                android:layout_height="wrap_content"

                android:layout_columnWeight="1"

                android:gravity="center"

                android:orientation="vertical">



                <androidx.cardview.widget.CardView

                    android:layout_width="50dp"

                    android:layout_height="50dp"

                    app:cardBackgroundColor="@color/laranja"

                    app:cardCornerRadius="4dp"

                    app:cardElevation="2dp">



                    <ImageView

                        android:layout_width="match_parent"

                        android:layout_height="match_parent"

                        android:padding="12dp"

                        android:src="@drawable/ic_ceramic" />

                </androidx.cardview.widget.CardView>



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Cerâmica"

                    android:textColor="@color/texto"

                    android:textSize="11sp" />

            </LinearLayout>



            <LinearLayout

                android:layout_width="0dp"

                android:layout_height="wrap_content"

                android:layout_columnWeight="1"

                android:gravity="center"

                android:orientation="vertical">



                <androidx.cardview.widget.CardView

                    android:layout_width="50dp"

                    android:layout_height="50dp"

                    app:cardBackgroundColor="@color/laranja"

                    app:cardCornerRadius="4dp"

                    app:cardElevation="2dp">



                    <ImageView

                        android:layout_width="match_parent"

                        android:layout_height="match_parent"

                        android:padding="12dp"

                        android:src="@drawable/ic_gastronomy" />

                </androidx.cardview.widget.CardView>



                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Gastronomia"
                    android:textColor="@color/texto"
                    android:textSize="11sp" />

            </LinearLayout>



        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="serif"
            android:text="Descubra produtos"
            android:textSize="24sp" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerProdutos"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/dotIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:orientation="horizontal" />

    </LinearLayout>
</FrameLayout>