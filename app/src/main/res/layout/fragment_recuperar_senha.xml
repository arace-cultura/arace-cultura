<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".ui.auth.RecuperarSenha">

    <ImageView
        android:id="@+id/bgPlaceholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.15"
        android:scaleType="centerCrop"
        android:src="@drawable/img_bg_explorar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:gravity="center_horizontal"
                android:text="@string/login_titulo"
                android:textColor="@color/texto"
                android:textFontWeight="400"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:gravity="center_horizontal"
                android:text="@string/login_subtitulo"
                android:textColor="@color/texto"
                android:textFontWeight="500"
                android:textSize="24sp" />

            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginBottom="30dp"
                android:contentDescription="@null"
                android:src="@drawable/panela_barro" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:text="@string/recuperar_titulo"
                android:textColor="@color/texto"
                android:textFontWeight="500"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:text="@string/recuperar_instrucao"
                android:textColor="@color/texto"
                android:textSize="15sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@color/bg"
                android:hint="@string/email"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@color/arace_blue"
                app:hintTextColor="@color/arace_blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/recuperarEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans_flex_variable_font"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/recuperarBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/arace_blue"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:paddingHorizontal="40dp"
                android:paddingVertical="12dp"
                android:text="@string/recuperar_botao"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/recuperarBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:text="@string/voltar"
                android:textColor="@color/black"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
