<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.auth.CadastroProdutorTela1"
    android:background="@drawable/f_login">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="350dp"
            android:layout_height="620dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginTop="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:layout_marginBottom="32dp"
                android:fontFamily="@font/librecaslondisplay_regular"
                android:text="Cadastro produtor"
                android:textColor="@color/white"
                android:textSize="55sp" />

            <EditText
                android:id="@+id/cadastro_razao_social"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/w_rectangle"
                android:hint="Razão Social"
                android:padding="16dp"
                android:textColor="@color/gray"
                android:textColorHint="@color/gray"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/cadastro_email_produtor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/w_rectangle"
                android:hint="CNPJ"
                android:inputType="textEmailAddress"
                android:padding="16dp"
                android:textColor="@color/gray"
                android:textColorHint="@color/gray"
                android:textSize="16sp" />

            <Button
                android:id="@+id/cadastroBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Terminar cadastro"
                android:backgroundTint="@color/white"
                android:textColor="@color/placeholder1"
                android:layout_marginTop="32dp"
                android:textSize="20sp" />

            <Button
                android:id="@+id/cadastro_produtor_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:text="Voltar"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:padding="0dp"/>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
