<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:gravity="center_horizontal"
                android:text="@string/cad_finalizar_titulo"
                android:textColor="@color/texto"
                android:textSize="24sp"
                android:textFontWeight="500" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@color/arace_blue"
                app:hintTextColor="@color/arace_blue"
                android:hint="@string/cad_cep">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans_flex_variable_font"
                    android:inputType="number"
                    android:textColor="@color/texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@color/arace_blue"
                app:hintTextColor="@color/arace_blue"
                android:hint="@string/cad_endereco">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans_flex_variable_font"
                    android:inputType="textPostalAddress"
                    android:textColor="@color/texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@color/arace_blue"
                app:hintTextColor="@color/arace_blue"
                android:hint="@string/cad_tipo_artesanato">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTipoArtesanato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans_flex_variable_font"
                    android:inputType="text"
                    android:textColor="@color/texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@color/arace_blue"
                app:hintTextColor="@color/arace_blue"
                android:hint="@string/cad_categoria_produto">

                <AutoCompleteTextView
                    android:id="@+id/acCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:fontFamily="@font/google_sans_flex_variable_font"
                    android:textColor="@color/texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/cad_historia_loja"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@color/arace_blue"
                app:hintTextColor="@color/arace_blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHistoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans_flex_variable_font"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:textColor="@color/texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@color/arace_blue"
                app:hintTextColor="@color/arace_blue"
                app:helperText="@string/cad_pix_helper"
                android:hint="@string/cad_chave_pix">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etChavePix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans_flex_variable_font"
                    android:inputType="text"
                    android:textColor="@color/texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/senha_loja"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@color/arace_blue"
                app:hintTextColor="@color/arace_blue"
                app:passwordToggleEnabled="true"
                app:helperText="@string/cad_senha_loja_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSenhaLoja"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans_flex_variable_font"
                    android:inputType="textPassword"
                    android:textColor="@color/texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnSelecionarBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:backgroundTint="@color/arace_blue"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:text="@string/selecionar_banner"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvBannerSelecionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:text="@string/nenhum_banner"
                android:textColor="@color/texto"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSelecionarFotoLoja"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:backgroundTint="@color/arace_blue"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:text="@string/cad_selecionar_foto_loja"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvFotoLojaSelecionada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:text="@string/nenhuma_foto"
                android:textColor="@color/texto"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSelecionarFotosHistoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:backgroundTint="@color/arace_blue"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:text="@string/cad_selecionar_fotos_historia"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvFotosHistoriaSelecionadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:text="@string/nenhuma_foto"
                android:textColor="@color/texto"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/llPreviewHistoria"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:weightSum="3"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivHistoria1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:scaleType="centerCrop"
                    android:background="@color/arace_blue"
                    android:contentDescription="@string/cad_foto_historia_1" />

                <ImageView
                    android:id="@+id/ivHistoria2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:scaleType="centerCrop"
                    android:background="@color/arace_blue"
                    android:contentDescription="@string/cad_foto_historia_2" />

                <ImageView
                    android:id="@+id/ivHistoria3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scaleType="centerCrop"
                    android:background="@color/arace_blue"
                    android:contentDescription="@string/cad_foto_historia_3" />

            </LinearLayout>

            <Button
                android:id="@+id/btnFinalizar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/arace_blue"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:paddingHorizontal="40dp"
                android:paddingVertical="12dp"
                android:text="@string/cad_cadastrar_produtor"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnVoltar3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/google_sans_flex_variable_font"
                android:text="@string/voltar"
                android:textColor="@color/black"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
