<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.NavegacaoPrincipal">

    <!--
        Essa outra fragment container view é necessária para
        utilizar o bottom navigation view nas páginas principais.
        Caso não se deseje utilizar o bottom navigation view, é só
        utilizar findNavController(requireActivity()), pois o
        fragment container view da activity, que é o principal,
        utiliza a tela inteira, ou seja, é o "canvas principal"
        da interface da aplicação.

        adicionar defaultNavHost se, ao voltar, não fechar
        completamente o app, isso com o backstack limpo.
    -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fcvNavegacaoPrincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bnvMenuInferiorNavegacao"
        app:navGraph="@navigation/graph_main"
        android:name="androidx.navigation.fragment.NavHostFragment"
        app:defaultNavHost="true"
        />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bnvMenuInferiorNavegacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemGravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fcvNavegacaoPrincipal"
        app:itemPaddingBottom="12dp"
        app:itemPaddingTop="12dp"
        app:menu="@menu/bottom_nav" />
</androidx.constraintlayout.widget.ConstraintLayout>