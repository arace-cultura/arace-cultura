<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.NavegacaoPrincipal">

    <!--
        A AppBarLayout é responsável pelo commportamento esperado do container da
        MaterialToolbar. Como, por exemplo, elevação e interação ao scroll.

        O ImageButton foi preciso para colocaar o botão na direita.

    -->

    <com.google.android.material.appbar.AppBarLayout
        android:elevation="8dp"
        android:id="@+id/appBarLayout"
        android:background="#F9F8F7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <ImageButton
                android:id="@+id/btnMenuModo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="16dp"
                android:src="@drawable/ic_menu"/>

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!--
        Essa outra fragment container view é necessária para
        utilizar o bottom navigation view nas páginas principais.
        Caso não se deseje utilizar o bottom navigation view, é só
        utilizar findNavController(requireActivity()), pois o
        fragment container view da activity, que é o principal,
        utiliza a tela inteira, ou seja, é o "canvas principal"
        da interface da aplicação.

        adicionar defaultNavHost se, ao voltar, não fechar
        completamente o app, isso com o backstack limpo.
    -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fcvNavegacaoPrincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bnvMenuInferiorNavegacao"
        app:navGraph="@navigation/main_graph"
        android:name="androidx.navigation.fragment.NavHostFragment"
        app:defaultNavHost="true"
        />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:elevation="8dp"
        app:itemIconSize="28dp"
        android:background="#F9F8F7"
        app:itemActiveIndicatorStyle="@null"
        app:itemTextColor="@color/texto"
        android:id="@+id/bnvMenuInferiorNavegacao"
        app:itemIconTint="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemGravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fcvNavegacaoPrincipal"
        app:itemPaddingBottom="12dp"
        app:itemPaddingTop="12dp"
        app:menu="@menu/bottom_nav" />
</androidx.constraintlayout.widget.ConstraintLayout>