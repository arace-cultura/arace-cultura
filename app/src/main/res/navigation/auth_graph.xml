<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_graph"
    app:startDestination="@id/entrada">

    <fragment
        android:id="@+id/login"
        android:name="com.aracecultura.arace.ui.auth.Login"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" />
    <fragment
        android:id="@+id/cadastro"
        android:name="com.aracecultura.arace.ui.auth.Cadastro"
        android:label="fragment_cadastro"
        tools:layout="@layout/fragment_cadastro" />
    <fragment
        android:id="@+id/entrada"
        android:name="com.aracecultura.arace.ui.auth.Entrada"
        android:label="fragment_entrada"
        tools:layout="@layout/fragment_entrada">
        <action
            android:id="@+id/action_entrada_to_login"
            app:destination="@id/login" />
        <action
            android:id="@+id/action_entrada_to_cadastro"
            app:destination="@id/cadastro" />
    </fragment>
    <argument
        android:name="showBottomNav"
        android:defaultValue="false"
        app:argType="boolean"/>

</navigation>