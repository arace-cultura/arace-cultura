<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/homePage">

    <fragment
        android:id="@+id/produto"
        android:name="com.aracecultura.arace.ui.Produto"
        android:label="Produto"
        tools:layout="@layout/fragment_produto">
        <argument
            android:name="showBottomNav"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/homePage"
        android:name="com.aracecultura.arace.ui.main.HomePage"
        android:label="fragment_home_page"
        tools:layout="@layout/fragment_home_page" >
        <action
            android:id="@+id/action_homePage_to_produto"
            app:destination="@id/produto" />
    </fragment>
    <fragment
        android:id="@+id/favoritos"
        android:name="com.aracecultura.arace.ui.main.Favoritos"
        android:label="fragment_favoritos"
        tools:layout="@layout/fragment_favoritos" />
    <argument
        android:name="showBottomNav"
        android:defaultValue="true"
        app:argType="boolean"/>
</navigation>